# Enforce consistent line endings across platforms
* text=auto

# C# source and project files — must match .editorconfig (end_of_line = crlf)
*.cs    text eol=crlf
*.csproj text eol=crlf
*.sln   text eol=crlf
*.slnx  text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Web / config files
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf

# Binaries — do not touch
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
